{
  "name": "pkg-name",
  "version": "0.0.0",
  "description": "pkg-name",
  "keywords": [],
  "homepage": "https://github.com/LoTwT/pkg-name#readme",
  "bugs": {
    "url": "https://github.com/LoTwT/pkg-name/issues"
  },
  "license": "MIT",
  "author": "LoTwT <l709937065@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/pkg-name.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./*"
      ]
    }
  },
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --report-unused-disable-directives-severity=error && oxfmt --check",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build",
    "release": "bumpp && pnpm publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "up": "taze latest -I -f"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "oxlint --type-aware --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.18.0"
}
