{
  "name": "pkg-name",
  "version": "0.0.0",
  "description": "pkg-name",
  "keywords": [],
  "homepage": "https://github.com/LoTwT/pkg-name#readme",
  "bugs": {
    "url": "https://github.com/LoTwT/pkg-name/issues"
  },
  "license": "MIT",
  "author": "LoTwT <l709937065@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/pkg-name.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "deps": "taze latest -I -f",
    "dev": "tsdown --watch",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build",
    "release": "bumpp && pnpm publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.6.6",
    "bumpp": "^12.3.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "taze": "^21.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm format:check && pnpm typecheck"
  },
  "tsdown": {
    "attw": {
      "level": "error"
    },
    "exports": true,
    "publint": true
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
